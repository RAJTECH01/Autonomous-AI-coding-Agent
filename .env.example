###############################################################################
# Autonomous AI Coding Agent Platform - environment template
#
# HOW TO USE
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#   then fill in every value marked CHANGE-ME.
#
# .env is gitignored. Never commit it. Never bake these values into a Dockerfile.
# Compose reads this file and injects the values as container environment
# variables, so nothing here ends up in an image layer.
#
# IMPORTANT TRAP: do NOT copy this file to backend/.env.
#   app/core/config.py uses Settings(env_file=".env", extra="forbid"). pydantic
#   reads *every* key from a dotenv file and rejects keys that are not Settings
#   fields, so a backend/.env containing the deployment-only keys below
#   (DOCKER_HOST, TAG, backup settings, ...) would crash the app at import.
#   Environment variables are matched only against declared fields, so the
#   Compose injection path used here is safe.
###############################################################################

# =============================================================================
# Application core
# =============================================================================
# Anything outside {development, test, local} activates the production
# hardening validator in app/core/config.py, which refuses to boot on a weak
# SECRET_KEY, DEBUG=true, or SANDBOX_ALLOW_HOST_FALLBACK=true.
ENVIRONMENT=production
DEBUG=false

# Signs JWTs. Must be unique per environment and >= 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-generate-a-random-48-byte-url-safe-string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Parsed as JSON (pydantic complex type). A comma-separated list will NOT work.
ALLOWED_ORIGINS=["https://agent.example.com"]

# =============================================================================
# PostgreSQL
# =============================================================================
# POSTGRES_SERVER is the Compose service name on the app network.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=CHANGE-ME-strong-database-password

# =============================================================================
# Redis (Celery broker + result backend for the worker service)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# AI providers - all optional at boot, required for a session to actually run
# =============================================================================
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_MODEL_NAME=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Sandbox execution
# =============================================================================
SANDBOX_RUNTIME=docker
SANDBOX_DEFAULT_RUNTIME=python
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPUS=2.0
SANDBOX_MAX_PIDS=100
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_LOG_MAX_SIZE=5m
# Runs model-generated commands directly on the host. Never true outside dev;
# the production validator rejects it.
SANDBOX_ALLOW_HOST_FALLBACK=false

# =============================================================================
# Agent loop
# =============================================================================
MAX_AGENT_ITERATIONS=20
MAX_CONTEXT_TOKENS=128000

# =============================================================================
# Deployment-only settings (consumed by Compose / entrypoints, NOT by pydantic)
# =============================================================================
# Image tag applied to all first-party images.
TAG=1.0.0
IMAGE_REGISTRY=ghcr.io/your-org

# Docker API endpoint used by the sandbox adapter. Points at the sandbox-broker
# socket proxy so the app never receives the raw host socket.
DOCKER_HOST=tcp://sandbox-broker:2375

# Sandbox scratch root. Must be the SAME absolute path on the Docker host and
# inside the worker container, otherwise nested sandbox bind mounts resolve to
# an empty directory. See docs/DEPLOYMENT.md "Workspace path identity".
SANDBOX_WORKSPACE_ROOT=/srv/agent/sandboxes

# Set ALEMBIC_UPGRADE_ON_START=1 only on the dedicated migrate service.
# Leave 0 for api/worker so replicas never race each other on schema changes.
ALEMBIC_UPGRADE_ON_START=0

# Uvicorn graceful shutdown budget, seconds.
GRACEFUL_TIMEOUT=30

# Published edge ports (reverse proxy).
HTTP_PORT=80
HTTPS_PORT=443
# Hostname used in the nginx server_name and the HTTPS redirect.
PUBLIC_HOSTNAME=agent.example.com

# =============================================================================
# Backups
# =============================================================================
BACKUP_SCHEDULE_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/backups
